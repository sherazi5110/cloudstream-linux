<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sherazi5110.CloudStreamLinux</id>
  <name>CloudStream</name>
  <summary>Run CloudStream extensions on Linux</summary>
  <developer id="io.github.sherazi5110">
    <name>Tennant Creek</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>
      A media center that installs and runs CloudStream extensions from the same
      repositories the Android app uses, unchanged.
    </p>
    <ul>
      <li>Built-in player using VLC's engine: hardware decoding, source switching, audio languages, speed and zoom</li>
      <li>Subtitles from extensions, from OpenSubtitles (no account needed) or from files</li>
      <li>Home catalogs you can hide, reorder and combine across extensions</li>
      <li>Library with history, resume and Continue Watching</li>
      <li>Downloads for watching offline, including HLS streams</li>
      <li>Skip intro for anime and a next-episode countdown</li>
      <li>Live TV with a TV guide grid</li>
      <li>Themes, including AMOLED black and light, with custom accent colours and wallpapers</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.sherazi5110.CloudStreamLinux.desktop</launchable>
